{
  "name": "claude-code-scheduler",
  "displayName": "Prompt Scheduler for Claude Code",
  "description": "Schedule recurring Claude Code CLI prompts on Linux, macOS, and Windows, managed from a VS Code panel.",
  "version": "0.2.0",
  "publisher": "Adza",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "cron",
    "scheduler",
    "automation",
    "ai"
  ],
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/markoAdza/claude-code-scheduler.git"
  },
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeCodeScheduler",
          "title": "Claude Code Scheduler",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "claudeCodeScheduler": [
        {
          "id": "claudeCodeSchedulerJobs",
          "name": "Jobs"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "claudeCodeSchedulerJobs",
        "contents": "No scheduled jobs yet.\n[Add Job](command:claudeCodeScheduler.addJob)"
      }
    ],
    "commands": [
      {
        "command": "claudeCodeScheduler.addJob",
        "category": "Claude Code Scheduler",
        "title": "Add Job",
        "icon": "$(add)"
      },
      {
        "command": "claudeCodeScheduler.editJob",
        "category": "Claude Code Scheduler",
        "title": "Edit Job",
        "icon": "$(edit)"
      },
      {
        "command": "claudeCodeScheduler.deleteJob",
        "category": "Claude Code Scheduler",
        "title": "Delete Job",
        "icon": "$(trash)"
      },
      {
        "command": "claudeCodeScheduler.toggleJob",
        "category": "Claude Code Scheduler",
        "title": "Enable/Disable Job",
        "icon": "$(circle-slash)"
      },
      {
        "command": "claudeCodeScheduler.runJobNow",
        "category": "Claude Code Scheduler",
        "title": "Run Now",
        "icon": "$(play)"
      },
      {
        "command": "claudeCodeScheduler.viewOutput",
        "category": "Claude Code Scheduler",
        "title": "View Last Output",
        "icon": "$(output)"
      },
      {
        "command": "claudeCodeScheduler.openPromptFile",
        "category": "Claude Code Scheduler",
        "title": "Open Prompt File",
        "icon": "$(file-text)"
      },
      {
        "command": "claudeCodeScheduler.redetectClaudeCli",
        "category": "Claude Code Scheduler",
        "title": "Re-detect Claude CLI"
      },
      {
        "command": "claudeCodeScheduler.resyncCrontab",
        "category": "Claude Code Scheduler",
        "title": "Resync Schedule",
        "icon": "$(sync)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "claudeCodeScheduler.addJob",
          "when": "view == claudeCodeSchedulerJobs",
          "group": "navigation@1"
        },
        {
          "command": "claudeCodeScheduler.resyncCrontab",
          "when": "view == claudeCodeSchedulerJobs",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "claudeCodeScheduler.runJobNow",
          "when": "view == claudeCodeSchedulerJobs",
          "group": "inline@1"
        },
        {
          "command": "claudeCodeScheduler.editJob",
          "when": "view == claudeCodeSchedulerJobs",
          "group": "inline@2"
        },
        {
          "command": "claudeCodeScheduler.runJobNow",
          "when": "view == claudeCodeSchedulerJobs",
          "group": "1_actions@1"
        },
        {
          "command": "claudeCodeScheduler.editJob",
          "when": "view == claudeCodeSchedulerJobs",
          "group": "1_actions@2"
        },
        {
          "command": "claudeCodeScheduler.toggleJob",
          "when": "view == claudeCodeSchedulerJobs",
          "group": "1_actions@3"
        },
        {
          "command": "claudeCodeScheduler.viewOutput",
          "when": "view == claudeCodeSchedulerJobs",
          "group": "2_inspect@1"
        },
        {
          "command": "claudeCodeScheduler.openPromptFile",
          "when": "view == claudeCodeSchedulerJobs",
          "group": "2_inspect@2"
        },
        {
          "command": "claudeCodeScheduler.deleteJob",
          "when": "view == claudeCodeSchedulerJobs",
          "group": "3_destructive@1"
        }
      ]
    },
    "configuration": {
      "title": "Claude Code Scheduler",
      "properties": {
        "claudeCodeScheduler.claudeExecutablePath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the `claude` CLI executable. Leave empty to auto-detect."
        },
        "claudeCodeScheduler.additionalPathEntries": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra directories prepended to PATH (or Path on Windows) in generated job scripts (e.g. an nvm Node bin directory)."
        },
        "claudeCodeScheduler.dataDirectory": {
          "type": "string",
          "default": "~/.claude-code-scheduler",
          "description": "Directory where job definitions, generated scripts, prompts, and logs are stored."
        },
        "claudeCodeScheduler.shell": {
          "type": "string",
          "default": "",
          "description": "Linux/macOS only. Shell used to run generated job scripts and detect the claude CLI. Leave empty to use $SHELL, falling back to /bin/bash. Ignored on Windows, where jobs always run via PowerShell."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "pretest": "npm run compile-tests && npm run compile",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test:unit": "npm run compile-tests && mocha \"out/test/unit/**/*.test.js\"",
    "test": "npm run test:unit && vscode-test"
  },
  "dependencies": {
    "cron-parser": "^5.8.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "mocha": "^11.8.0",
    "typescript": "^6.0.3"
  }
}
